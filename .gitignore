# Environnements
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Donnees : jamais dans le suivi de version
data/raw/*
data/processed/*
data/exports/*
!data/**/.gitkeep

# Modeles serialises et rapports generes. Motifs ancres a la racine : un motif
# nu comme models/ exclut tout dossier de ce nom, y compris le paquet
# src/churn/models/, qui serait reste hors du depot sans aucune erreur.
/models/
/reports/
*.pkl
*.joblib
*.ubj

# Secrets. Ces fichiers vivent normalement hors du depot, dans ~/.kaggle,
# mais une copie egaree dans le projet ne doit jamais partir en commit.
.env
*.pem
kaggle.json
access_token
access_token.txt
*.token

# Outils
# Reglages d'editeur : ils appartiennent au poste, pas au projet.
.vscode/
.idea/
.ipynb_checkpoints/
.DS_Store
*.log

# Documents de reference externes, non redistribues
refs/AGENTS.md_GUIDE.pdf
